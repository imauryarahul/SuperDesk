# Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used to build invite links. Optional locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email channel (Postmark) ----------------------------------------------------

# Servers > your server > API Tokens
POSTMARK_SERVER_TOKEN=your-postmark-server-token

# Must be a verified Sender Signature, or any address on a verified domain.
POSTMARK_FROM_EMAIL=support@yourdomain.com

# Servers > your server > Inbound. The account-wide address; each workspace's
# own address is this with its inbound_token as a plus-suffix.
POSTMARK_INBOUND_ADDRESS=yourhash@inbound.postmarkapp.com

# Basic Auth on the inbound webhook. Set the Postmark inbound webhook URL to
# https://USER:PASS@your-app.com/api/webhooks/postmark-inbound with these values.
POSTMARK_INBOUND_WEBHOOK_USER=postmark
POSTMARK_INBOUND_WEBHOOK_PASS=generate-a-long-random-value

# AI summaries and reply drafts (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
