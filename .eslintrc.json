{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    // useFormState fixes an action's signature as (prevState, formData), so an
    // action needing neither still has to declare them. Those are marked with a
    // leading underscore, which this makes the linter honour.
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ]
  }
}
